# Meridian local/staging environment example
# Do not commit real secrets. Keep live trading disabled until explicit approval and final staging gates pass.

LIVE_TRADING_ENABLED=false

# Solana RPC / Helius
# Private RPC is required before live trading; public fallback is read-only only.
HELIUS_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=
QUICKNODE_RPC_URL=
TRITON_RPC_URL=
SYNDICA_RPC_URL=
ALCHEMY_RPC_URL=
CHAINSTACK_RPC_URL=
ANKR_RPC_URL=
JITO_RPC_URL=

# Market-data enrichment
# Birdeye is preferred for wallet-attributed token trade tape when configured.
BIRDEYE_API_KEY=

# Optional holder-list enrichment. If missing, terminal falls back to Helius/RPC/Pump.fun/RugCheck.
SOLSCAN_API_KEY=
SOLSCAN_PRO_API_KEY=

# Optional deeper historical/pool-age enrichment
BITQUERY_API_KEY=

# Optional active token fixture for testing trade tape without using USDC.
# If unset, /api/market-data/probe-token searches DexScreener read-only.
RECOMMENDED_PROBE_MINT=

# Live safety limits; leave conservative in staging.
LIVE_MAX_SOL_PER_SWAP=0.05
LIVE_MAX_USDC_PER_SWAP=10
LIVE_MAX_SLIPPAGE_BPS=500

# Production live mode still requires a real durable adapter + operator auth.
DATABASE_URL=
LIVE_STORE_DATABASE_URL=

# Dedicated RPC/live-readiness. Server-only; do not prefix secrets with NEXT_PUBLIC_.
SOLANA_RPC_PROVIDER_LABEL=
HELIUS_RPC_PROVIDER_LABEL=Helius
QUICKNODE_RPC_PROVIDER_LABEL=QuickNode
TRITON_RPC_PROVIDER_LABEL=Triton
SYNDICA_RPC_PROVIDER_LABEL=Syndica
ALCHEMY_RPC_PROVIDER_LABEL=Alchemy
CHAINSTACK_RPC_PROVIDER_LABEL=Chainstack
ANKR_RPC_PROVIDER_LABEL=Ankr
JITO_RPC_PROVIDER_LABEL=Jito
SOLANA_RPC_WS_URL=
QUICKNODE_RPC_WS_URL=
TRITON_RPC_WS_URL=
SYNDICA_RPC_WS_URL=
ALCHEMY_RPC_WS_URL=
CHAINSTACK_RPC_WS_URL=
ANKR_RPC_WS_URL=
JITO_RPC_WS_URL=
SOLANA_RPC_HEALTH_TIMEOUT_MS=2500

# Meridian operator session gate. Required before Wallet Ops/Terminal live-readiness can pass.
MERIDIAN_SESSION_SECRET=
MERIDIAN_OPERATOR_KEY=
