{
  "name": "solana-spl-market-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dry-run-first Solana SPL token market-maker foundation with explicit risk controls.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dry-run": "MARKET_MAKER_MODE=dry-run tsx src/index.ts",
    "paper": "MARKET_MAKER_MODE=paper tsx src/index.ts",
    "paper:report": "tsx scripts/generate-paper-report.ts",
    "paper:observe-report": "tsx scripts/generate-observed-paper-report.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "observe": "tsx scripts/observe.ts",
    "openbook:market": "tsx scripts/openbook-market.ts",
    "web:dev": "pnpm --filter @soulana/market-maker-web dev",
    "web:build": "pnpm --filter @soulana/market-maker-web build",
    "web:check": "pnpm --filter @soulana/market-maker-web check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@jup-ag/api": "^6.0.48",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.11.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@meteora-ag/dlmm": "^1.9.11",
    "@openbook-dex/openbook-v2": "^0.2.10",
    "@orca-so/whirlpools": "^8.0.1",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.58-alpha",
    "jito-ts": "^4.2.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
