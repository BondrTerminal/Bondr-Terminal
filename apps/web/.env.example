# Public browser-safe values only. Never put private keys or RPC secrets in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_APP_NAME=Meridian
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_READ_ONLY_MODE=true

# Turnkey embedded-wallet login. These IDs are public config values, not private API secrets.
# Enable Auth Proxy + email OTP/passkey/wallet auth in the Turnkey dashboard first.
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=

# Server-only Vercel env vars. Keep these in Vercel/localhost env, not in the browser.
# Preferred token-stats/indexer RPC order: HELIUS_RPC_URL, HELIUS_API_KEY, QUICKNODE_RPC_URL, TRITON_RPC_URL, SOLANA_RPC_URL, public fallback.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
# HELIUS_API_KEY=
# SOLANA_RPC_URL=

# Jupiter quote/route preview and gated swap transaction builder. JUPITER_API_KEY is optional and server-only.
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1/swap
# JUPITER_API_KEY=

# Optional: remote status API. Leave unset to read local MARKET_MAKER_STATUS_FILE or fallback mock data.
MARKET_MAKER_STATUS_URL=
MARKET_MAKER_CONTROL_API_KEY=

# Live execution kill switch. Keep false until signer custody, preflight, limits, and explicit approval are finished.
LIVE_TRADING_ENABLED=false
LIVE_MAX_SOL_PER_SWAP=0.05
LIVE_MAX_USDC_PER_SWAP=10
LIVE_MAX_SLIPPAGE_BPS=500

# Optional: server-side local status file generated by `pnpm observe -- config/market-maker.local.json`.
MARKET_MAKER_STATUS_FILE=runtime/market-maker-status.local.json

# Optional Solscan Pro token holder API. Used by /api/token-stats before Helius/RPC fallbacks.
SOLSCAN_API_KEY=
# SOLSCAN_PRO_API_KEY=
